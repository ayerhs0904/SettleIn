# SettleIn Backend Environment Variables Template
# On Render: Configure these under "Environment Variables" in your Web Service dashboard

# Server port (Automatically assigned by Render via $PORT)
PORT=8080

# PostgreSQL / Supabase Database Connection
# Format for Supabase Connection Pooler (Transaction Mode, Port 6543):
# DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Or standard URI: postgres://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_URL=jdbc:postgresql://localhost:5432/settlein
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# Database connection pool size (Default: 10)
DB_POOL_SIZE=10

# Hibernate schema auto-management (Recommended: 'update' for dev/demo, 'validate' for strict production)
JPA_DDL_AUTO=update

# JWT Secret Key (Must be at least 256 bits / 32 characters hex string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
# E.g.: https://settlein.vercel.app,https://settlein-yourname.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://settlein.vercel.app,http://localhost:5173,http://localhost:3000

# Optional: Google Gemini API Key for external AI features (if configured)
GEMINI_API_KEY=
