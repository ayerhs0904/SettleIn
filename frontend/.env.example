# SettleIn Frontend Environment Variables Template
# Copy this file to .env.local for local overrides, or .env.production for production

# Backend API Base URL
# For local development: http://localhost:8080/api
# For Render deployment: https://settlein-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Optional: Environment flag
VITE_APP_ENV=development
